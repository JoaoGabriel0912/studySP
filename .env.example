# Porta do Servidor (opcional, padrão 3000)
PORT=3000

# Chave da API Gemini (Google AI Studio) — obrigatória para a IA do aluno
GEMINI_API_KEY=sua_chave_aqui
# Modelo opcional (padrão: gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-lite-latest

# String de conexão com PostgreSQL (opcional: se não preenchido, usa SQLite/JSON local automaticamente)
# Exemplo para Render / Railway / Supabase:
# DATABASE_URL=postgresql://usuario:senha@host:5432/nomedobanco
